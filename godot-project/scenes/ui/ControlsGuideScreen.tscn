[node name="Body" type="Label" parent="CenterPanel/Card/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.84, 0.88, 0.94, 1)
theme_override_font_sizes/font_size = 18
text = "• PULGAR IZQUIERDO (Joystick): Mueve al agente SWAT en cualquier dirección. Empuja al máximo hacia adelante para correr.
• PULGAR DERECHO (Pantalla): Arrastra el dedo por la pantalla para girar la cámara y apuntar con precisión.
• BOTÓN DISPARAR: Botón circular principal. Mantén pulsado para ráfaga automática y desliza el dedo para corregir la mira al disparar.
• ARCO TÁCTICO (MIRA / RECARGAR / AGACHAR / SALTAR): Botones circulares cómodos alrededor del pulgar derecho sin tapar el arma.
• PUERTAS E INDICADOR DE DAÑO: Acércate a una puerta para abrirla; los bordes rojos indican la dirección del fuego enemigo."
autowrap_mode = 2

